      "name": "Google Sheets - 建立每日試算表",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.5,
      "position": [
        1280,
        544
      ],
      "executeOnce": true,
      "credentials": {
        "googleSheetsOAuth2Api": {
          "id": "9rI8zBeZbzWUf5tr",
          "name": "Google Sheets account"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const src = $('HTTP Request - 呼叫本地執行 stock02.py').first().json;\n\nif (!Array.isArray(src.records)) {\n  throw new Error('HTTP Request 回傳資料中找不到 records 陣列');\n}\n\nconst headers = [\n  'ETF代號',\n  'ETF名稱',\n  '淨值',\n  '淨值漲跌%',\n  '市價',\n  '市價漲跌%',\n  '折溢價',\n  '折溢價%',\n  '成交量',\n  '追蹤標的'\n];\n\nconst values = [\n  headers,\n  ...src.records.map(row => headers.map(h => {\n    const value = row[h] ?? '';\n    // ETF 代號強制保留為字串，例如 0050、00929、006208、00631L\n    return h === 'ETF代號' ? String(value) : value;\n  }))\n];\n\nreturn [{\n  json: {\n    date: src.date,\n    sheet_name: src.sheet_name,\n    total_count: src.total_count,\n    values\n  }\n}];"
      },
      "id": "87e21b79-cbd7-4f32-99b2-bde5092d16ef",
      "name": "Code - 準備 Google Sheets 資料",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1536,
        544
      ]
    },
    {
      "parameters": {
        "method": "PUT",
        "url": "=https://sheets.googleapis.com/v4/spreadsheets/{{ $('Google Sheets - 建立每日試算表').first().json.spreadsheetId }}/values/ETF!A1",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "googleSheetsOAuth2Api",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "valueInputOption",
              "value": "RAW"
            }
          ]
        },
        "sendBody": true,
        "contentType": "raw",
        "rawContentType": "application/json",
        "body": "={{ JSON.stringify({ values: $json.values }) }}",
        "options": {
          "timeout": 120000
        }
      },
      "id": "d0c5417d-d993-4bb1-8907-b46c5c85d0be",
