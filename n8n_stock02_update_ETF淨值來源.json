    {
      "parameters": {
        "jsCode": "const src = $('HTTP Request - 呼叫本地執行 stock02.py').first().json;\n\nif (!Array.isArray(src.records)) {\n  throw new Error('HTTP Request 回傳資料中找不到 records 陣列');\n}\n\nconst headers = [\n  'ETF代號',\n  'ETF名稱',\n  '淨值',\n  '淨值漲跌%',\n  '市價',\n  '市價漲跌%',\n  '折溢價',\n  '折溢價%',\n  '成交量',\n  '追蹤標的'\n];\n\nconst values = src.records.map(row => headers.map(h => {\n  const value = row[h] ?? '';\n  // ETF代號固定以字串寫入，搭配 RAW 保留 0050、00929、00631L 等格式\n  return h === 'ETF代號' ? String(value) : value;\n}));\n\nreturn [{\n  json: {\n    date: src.date,\n    total_count: src.total_count,\n    values\n  }\n}];"
      },
      "id": "a056a511-23ed-4d9a-87eb-05c58af7e124",
